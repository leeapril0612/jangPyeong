generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockSnapshot {
  id        Int      @id @default(autoincrement())
  symbol    String
  price     Int
  change    Int
  volume    Int
  createdAt DateTime @default(now())

  @@index([symbol, createdAt])
}
